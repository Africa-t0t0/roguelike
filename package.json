{
  "name": "roguelike-coop",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently -n server,client \"npm run dev -w @roguelike/server\" \"npm run dev -w @roguelike/client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "NODE_ENV=production npm run start -w @roguelike/server"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
